[Unit]
Description=Private virtual desktop for Binance browser login
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=DISPLAY=:99
ExecStart=/usr/local/bin/binance-browser-desktop
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
